# Proveedor de IA en servidor. Por defecto usar "stub" hasta integrar Claude de forma controlada.
AI_PROVIDER=stub

# Reservado para fases posteriores; no poner claves reales en el repositorio.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-haiku-4-5

# Supabase (sin claves reales en el repo). SUPABASE_SERVICE_ROLE_KEY solo en servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Automatización / integración n8n (futura; ver docs/spec-automation-integration-mvp.md)
# Mantén false salvo que configures un webhook en n8n. No implica que la integración esté implementada aún.
# N8N_WEBHOOK_SECRET solo servidor; nunca NEXT_PUBLIC_* ni frontend.
AUTOMATIONS_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
